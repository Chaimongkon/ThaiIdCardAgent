NEXT_PUBLIC_THAI_ID_AGENT_BASE_URL=https://localhost:18443
THAI_ID_AGENT_JWT_PRIVATE_KEY_PATH=<PATH-TO-SERVER-SIDE-TEST-PRIVATE-KEY-PEM>
THAI_ID_AGENT_JWT_ISSUER=thai-id-card-agent-client
THAI_ID_AGENT_JWT_AUDIENCE=thai-id-card-agent
THAI_ID_AGENT_JWT_SUBJECT=nextjs-client
THAI_ID_AGENT_WORKSTATION_ID=localhost-pilot
THAI_ID_AGENT_JWT_TTL_SECONDS=60

# --- Cooperative member directory -------------------------------------------------------------
# There is no switch that routes the production route to mock data. Mock members are reachable only
# through the development-only page at /dev/member-verification. With nothing configured below,
# POST /api/member/verify reports MEMBER_DB_NOT_CONFIGURED.
#
# Production lookup mapping. Every value must come from the cooperative DBA — nothing here is
# invented, and the lookup refuses to run while any value is an unresolved <PLACEHOLDER>.
# See config/member-database.config.template.json for the rules the statement must satisfy.
# MEMBER_DB_LOOKUP_SQL=<SELECT_STATEMENT_CONFIRMED_BY_DBA>
# MEMBER_DB_CITIZEN_ID_PARAMETER=<BIND_PARAMETER_NAME_AS_USED_IN_LOOKUP_SQL>
# MEMBER_DB_COLUMN_MEMBER_ID=<RESULT_COLUMN_FOR_INTERNAL_MEMBER_ID>
# MEMBER_DB_COLUMN_MEMBER_NO=<RESULT_COLUMN_FOR_MEMBER_NUMBER>
# MEMBER_DB_COLUMN_FULL_NAME=<RESULT_COLUMN_FOR_FULL_NAME>
# MEMBER_DB_COLUMN_MEMBER_TYPE=<RESULT_COLUMN_FOR_MEMBER_TYPE>
# MEMBER_DB_COLUMN_MEMBER_STATUS=<RESULT_COLUMN_FOR_MEMBER_STATUS>
# MEMBER_DB_COLUMN_PHOTO_REFERENCE=<RESULT_COLUMN_FOR_PHOTO_REFERENCE>
# MEMBER_DB_QUERY_TIMEOUT_MS=5000

# --- Staff session (production route) ----------------------------------------------------------
# Server-side only. Never a NEXT_PUBLIC_ variable, never sent to the browser, never committed.
# Without it the production route authenticates nobody and rejects every request.
# STAFF_SESSION_SECRET=<SERVER-SIDE-STAFF-SESSION-HMAC-SECRET>
# STAFF_SESSION_COOKIE_NAME=coop_staff_session

# --- Audit correlation --------------------------------------------------------------------------
# Keyed HMAC for linking audit records without storing the citizen ID. With no key, no hash is
# produced rather than a reversible one. Never commit this value.
# MEMBER_VERIFICATION_CORRELATION_KEY=<SERVER-SIDE-AUDIT-CORRELATION-SECRET>
